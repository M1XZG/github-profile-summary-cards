{
    "compilerOptions": {
        "target": "es2019",
        "lib": ["es2019", "dom"],
        "module": "commonjs",
        "outDir": "./lib",
        "rootDir": "./src",
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "types": ["node", "jest"],
        "skipLibCheck": true
    },
    "exclude": ["node_modules", "**/*.test.ts", "tests/*.ts", "api/**/*.ts"]
}
