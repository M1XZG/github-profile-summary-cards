{
    "collectCoverage": true,
    "clearMocks": true,
    "moduleFileExtensions": ["js", "ts"],
    "transform": {
        "^.+\\.ts$": "ts-jest"
    },
    "setupFilesAfterEnv": [],
    "testMatch": ["**/*.test.ts"],
    "verbose": true,
    "collectCoverageFrom": [
        "**/*.{ts,tsx}",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/lib/**"
    ]
}
